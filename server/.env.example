# Captain server settings. Copy to server/.env (local) or ../.env (Docker
# Compose), or set them in your host's dashboard. Only APP_SECRET and one
# model key are needed to go live.

# ---------------------------------------------------------------- basics
# Random, at least 32 characters. Signs file links. Generate: openssl rand -hex 32
APP_SECRET=
# The address people open (used in invite links).
PUBLIC_URL=http://localhost:8080
PORT=8080
DATABASE_URL=postgres://postgres@127.0.0.1:5432/captain
# Anyone can sign up and create a workspace (true), or only people with an invite link (false).
OPEN_SIGNUP=true
# Proxies in front of the server: 1 behind one load balancer (Render, Fly, Railway), false when
# exposed directly. Client IPs (rate limits, audit log) are read from X-Forwarded-For only that far.
TRUST_PROXY=false
# Browser origins allowed to call the API besides the server itself (the Mac app's are included).
# CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420

# ---------------------------------------------------------------- models
# Set any of these; the router uses every model whose provider has a key
# (see config/models.json). OpenRouter alone covers all of Captain's models.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
# MOONSHOT_API_KEY=
# Any OpenAI-compatible gateway (for example Captain's Yunwu account):
# LLM_GATEWAY_URL=https://example.com/v1
# LLM_GATEWAY_KEY=

# With no key at all, agents answer with a built-in demo model so you can click through everything.
LLM_DEMO_FALLBACK=true
# Ask a cheap model to rate difficulty when the heuristics say easy/balanced (one extra small call).
ROUTER_LLM_CLASSIFIER=false

# ---------------------------------------------------------------- agent tools
# Web search for agents (either one).
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Email that agents send after a person approves, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Captain <captain@example.com>
# Email recipients per workspace per day (stops an open sign-up from becoming a spam relay).
EMAIL_DAILY_LIMIT=100

# ---------------------------------------------------------------- limits
# AGENT_MAX_PARALLEL=3         # plan steps running at once
# AGENT_MAX_PLAN_STEPS=6
# AGENT_MAX_TOOL_ROUNDS=6
# WORKER_CONCURRENCY=4         # agent jobs per server
# MAX_UPLOAD_MB=25
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=20
# FILES_DIR=./data/files
# LOG_LEVEL=info
