# Copy to .env and fill in. Never commit .env.

# Database password for Mattermost's Postgres.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The address people use to reach Mattermost.
MM_SITE_URL=http://localhost:8065
# MATTERMOST_IMAGE_TAG=latest

# The first admin account, created by ./start.sh on the first run.
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=grace
ADMIN_PASSWORD=change-me-too

# Workspace that setup creates.
TEAM_NAME=captain
TEAM_DISPLAY_NAME=Captain

# Shared secret between Mattermost's button callbacks and the bridge.
BRIDGE_SECRET=change-me-as-well

# Written by setup: one bot access token per agent.
AGENT_TOKENS=

# Any OpenAI-compatible endpoint (Captain's router, OpenAI, OpenRouter...).
# Leave empty and the agents still run, with placeholder replies.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=auto
# A model that can read screenshots; falls back to LLM_MODEL.
LLM_VISION_MODEL=
